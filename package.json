{
  "name": "viewport-transform",
  "version": "0.1.1",
  "description": "A utility for handling coordinate transformations between an original image and a viewport",
  "main": "lib/index.js",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "coveralls": "jest --coverage && coveralls < coverage/lcov.info",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "build": "babel src --out-dir lib",
    "prepublishOnly": "npm run lint:fix && npm run test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "viewport",
    "transform",
    "image",
    "crop",
    "zoom",
    "coordinates"
  ],
  "author": "Brendan Conrad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brencon/viewport-transform.git"
  },
  "bugs": {
    "url": "https://github.com/brencon/viewport-transform/issues"
  },
  "homepage": "https://github.com/brencon/viewport-transform#readme",
  "devDependencies": {
    "@babel/cli": "^7.23.4",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "coveralls": "^3.1.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
